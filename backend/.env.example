# Copy this file to backend/.env and set strong values before deployment.
# Linux/macOS: cp .env.example .env

# Admin/API secrets (replace with strong random values)
DEVBITS_ADMIN_KEY=replace-with-strong-admin-key
DEVBITS_JWT_SECRET=replace-with-64-plus-char-random-secret

# Docker/Postgres values used by backend/docker-compose.yml
# Keep sslmode=disable for the internal Docker network.
DATABASE_URL=postgres://devbits:replace-with-strong-password@db:5432/devbits?sslmode=disable

# Docker database bootstrap values
POSTGRES_DB=devbits
POSTGRES_USER=devbits
POSTGRES_PASSWORD=replace-with-strong-password

# Optional: comma-separated CORS origins for browser clients.
DEVBITS_CORS_ORIGINS=https://devbits.ddns.net

# Runtime settings for Docker + nginx reverse proxy
DEVBITS_DEBUG=0
DEVBITS_API_ADDR=0.0.0.0:8080
DEVBITS_ADMIN_LOCAL_ONLY=1
# Set true only when running behind a trusted proxy (nginx) that sets X-Forwarded-Proto.
DEVBITS_TRUST_PROXY=true
